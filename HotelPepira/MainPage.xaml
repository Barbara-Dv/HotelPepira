<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelPepira.Views.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#d8b952">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Título -->
            <Label Text="Hotel Pepira"
                   FontSize="42"
                   FontAttributes="Bold"
                   TextColor="#5a6f22"
                   HorizontalOptions="Center"/>

            <!-- Sobre -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Sobre o Hotel"
                           Style="{StaticResource TituloCard}"/>

                    <Label Text="O Hotel Pepira oferece conforto, luxo e uma experiência inesquecível para famílias, casais e viajantes."
                           FontSize="16"/>

                    <Label Text="✔ Piscina"
                           FontSize="16"/>

                    <Label Text="✔ Restaurante"
                           FontSize="16"/>

                    <Label Text="✔ Suítes Premium"
                           FontSize="16"/>

                    <Label Text="✔ Vista Panorâmica"
                           FontSize="16"/>

                </VerticalStackLayout>
            </Frame>

            <!-- Avaliações -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout>

                    <Label Text="Avaliações"
                           Style="{StaticResource TituloCard}"/>

                    <Label Text="★★★★★"
                           FontSize="30"
                           TextColor="Gold"
                           HorizontalOptions="Center"/>

                    <Label Text="4.9 de 5 estrelas"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Localização -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Localização"
                           Style="{StaticResource TituloCard}"/>

                    <Label Text="📍 São Paulo - Brasil"/>

                    <Button Text="Ver localização"
                            Style="{StaticResource BotaoPadrao}"
                            Clicked="OnLocalizacaoClicked"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Navegação -->
            <Button Text="Fazer Check-in"
                    Style="{StaticResource BotaoPadrao}"
                    Clicked="OnHospedagemClicked"/>

            <Button Text="Avaliações"
                    Style="{StaticResource BotaoPadrao}"
                    Clicked="OnAvaliacoesClicked"/>

            <Button Text="Contato"
                    Style="{StaticResource BotaoPadrao}"
                    Clicked="OnContatoClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>