<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelPepira.Views.Avaliacoes"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F4EBD0">

    <ScrollView>

        <VerticalStackLayout Padding="18,24,18,30"
                             Spacing="18">


            <!-- ===================================================== -->
            <!-- CABEÇALHO -->
            <!-- ===================================================== -->

            <VerticalStackLayout Spacing="5">

                <Label Text="POUSADA JACARÉ PEPIRA"
                       FontSize="12"
                       FontAttributes="Bold"
                       CharacterSpacing="3"
                       TextColor="#5A6F22"
                       HorizontalTextAlignment="Center" />

                <Label Text="Avaliações"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="#5A6F22"
                       HorizontalTextAlignment="Center" />

                <BoxView HeightRequest="2"
                         WidthRequest="50"
                         BackgroundColor="#E8D48A"
                         HorizontalOptions="Center" />

                <Label Text="Veja o que os hóspedes têm a dizer"
                       FontSize="14"
                       TextColor="#777777"
                       HorizontalTextAlignment="Center"
                       Margin="0,3,0,0" />

            </VerticalStackLayout>


            <!-- ===================================================== -->
            <!-- RESUMO DA AVALIAÇÃO -->
            <!-- ===================================================== -->

            <Frame BackgroundColor="#5A6F22"
                   CornerRadius="22"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="#5A6F22">

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="22"
                      VerticalOptions="Center">

                    <!-- NOTA -->

                    <VerticalStackLayout Grid.Column="0"
                                         Spacing="2"
                                         HorizontalOptions="Center">

                        <Label Text="4,8"
                               FontSize="42"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />

                        <Label Text="de 5,0"
                               FontSize="12"
                               TextColor="#E8D48A"
                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>


                    <!-- ESTRELAS -->

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="5"
                                         VerticalOptions="Center">

                        <Label Text="★★★★★"
                               FontSize="25"
                               CharacterSpacing="2"
                               TextColor="#E8D48A" />

                        <Label Text="Experiências de hospedagem"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White" />

                        <Label Text="Conforto • Atendimento • Localização"
                               FontSize="11"
                               TextColor="#E8E1C9" />

                    </VerticalStackLayout>

                </Grid>

            </Frame>


            <!-- ===================================================== -->
            <!-- TÍTULO DOS DEPOIMENTOS -->
            <!-- ===================================================== -->

            <VerticalStackLayout Spacing="2"
                                 Margin="2,2,0,0">

                <Label Text="Experiências"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#5A6F22" />

                <Label Text="Alguns comentários apresentados no aplicativo"
                       FontSize="12"
                       TextColor="#888888" />

            </VerticalStackLayout>


            <!-- ===================================================== -->
            <!-- AVALIAÇÃO 1 -->
            <!-- ===================================================== -->

            <Frame BackgroundColor="White"
                   CornerRadius="20"
                   Padding="18"
                   HasShadow="True"
                   BorderColor="#E4D8B5">

                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Grid.Column="0"
                                             Spacing="2">

                            <Label Text="Hóspede"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#444444" />

                            <Label Text="Experiência de hospedagem"
                                   FontSize="11"
                                   TextColor="#999999" />

                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="★★★★★"
                               FontSize="17"
                               TextColor="#E8B92E"
                               VerticalOptions="Center" />

                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="#E8D48A" />

                    <Label Text="“Um lugar muito agradável, acolhedor e tranquilo. A experiência foi muito especial.”"
                           FontSize="14"
                           TextColor="#555555"
                           LineBreakMode="WordWrap"
                           LineHeight="1.25" />

                </VerticalStackLayout>

            </Frame>


            <!-- ===================================================== -->
            <!-- AVALIAÇÃO 2 -->
            <!-- ===================================================== -->

            <Frame BackgroundColor="White"
                   CornerRadius="20"
                   Padding="18"
                   HasShadow="True"
                   BorderColor="#E4D8B5">

                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Grid.Column="0"
                                             Spacing="2">

                            <Label Text="Hóspede"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#444444" />

                            <Label Text="Atendimento"
                                   FontSize="11"
                                   TextColor="#999999" />

                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="★★★★★"
                               FontSize="17"
                               TextColor="#E8B92E"
                               VerticalOptions="Center" />

                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="#E8D48A" />

                    <Label Text="“Atendimento atencioso e ambiente muito gostoso. Foi uma ótima escolha para descansar em Brotas.”"
                           FontSize="14"
                           TextColor="#555555"
                           LineBreakMode="WordWrap"
                           LineHeight="1.25" />

                </VerticalStackLayout>

            </Frame>


            <!-- ===================================================== -->
            <!-- AVALIAÇÃO 3 -->
            <!-- ===================================================== -->

            <Frame BackgroundColor="White"
                   CornerRadius="20"
                   Padding="18"
                   HasShadow="True"
                   BorderColor="#E4D8B5">

                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Grid.Column="0"
                                             Spacing="2">

                            <Label Text="Hóspede"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#444444" />

                            <Label Text="Localização e ambiente"
                                   FontSize="11"
                                   TextColor="#999999" />

                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="★★★★☆"
                               FontSize="17"
                               TextColor="#E8B92E"
                               VerticalOptions="Center" />

                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="#E8D48A" />

                    <Label Text="“O ambiente é muito agradável e a localização é ótima para quem quer conhecer as atrações de Brotas.”"
                           FontSize="14"
                           TextColor="#555555"
                           LineBreakMode="WordWrap"
                           LineHeight="1.25" />

                </VerticalStackLayout>

            </Frame>


            <!-- ===================================================== -->
            <!-- DESTAQUE -->
            <!-- ===================================================== -->

            <Frame BackgroundColor="#FFF8DD"
                   CornerRadius="20"
                   Padding="18"
                   HasShadow="False"
                   BorderColor="#E8D48A">

                <HorizontalStackLayout Spacing="12">

                    <Label Text="🌿"
                           FontSize="28"
                           VerticalOptions="Center" />

                    <VerticalStackLayout Spacing="3"
                                         VerticalOptions="Center">

                        <Label Text="Uma estadia especial"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#5A6F22" />

                        <Label Text="Natureza, descanso e a experiência de Brotas."
                               FontSize="12"
                               TextColor="#777777" />

                    </VerticalStackLayout>

                </HorizontalStackLayout>

            </Frame>


            <!-- ===================================================== -->
            <!-- BOTÃO VOLTAR -->
            <!-- ===================================================== -->

            <Button Text="←  Voltar"
                    BackgroundColor="Transparent"
                    TextColor="#5A6F22"
                    BorderColor="#5A6F22"
                    BorderWidth="1"
                    CornerRadius="16"
                    HeightRequest="52"
                    FontSize="15"
                    FontAttributes="Bold"
                    Clicked="OnVoltarClicked" />


            <!-- ===================================================== -->
            <!-- RODAPÉ -->
            <!-- ===================================================== -->

            <VerticalStackLayout Spacing="3"
                                 Margin="0,0,0,5">

                <Label Text="Pousada Jacaré Pepira"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#5A6F22"
                       HorizontalOptions="Center" />

                <Label Text="Brotas • São Paulo"
                       FontSize="11"
                       TextColor="#888888"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>


        </VerticalStackLayout>

    </ScrollView>

</ContentPage>